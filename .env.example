# Copy this file to .env and fill in real values. Never commit .env.

# Long random string; required when DJANGO_DEBUG=False.
DJANGO_SECRET_KEY=

# True for local development, False in production.
DJANGO_DEBUG=True

# Comma-separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Comma-separated, e.g. https://kararsizim.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=

# Leave empty to use local SQLite.
# Production: Supabase transaction pooler (port 6543).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
