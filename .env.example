# Copy this file to .env and fill in real values. Never commit .env.

# Long random string; required when DJANGO_DEBUG is False.
DJANGO_SECRET_KEY=

# Production is the default (False). Set True for local development only; the app
# refuses to start with DEBUG on Vercel.
DJANGO_DEBUG=True

# Comma-separated. In production use the exact host(s), e.g. kararsizim.vercel.app.
# ".vercel.app" matches every Vercel project: only use it for preview deployments.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated, e.g. https://kararsizim.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=

# Leave empty to use local SQLite. Tests always use SQLite.
# Local dev / migrate: Supabase session pooler (port 5432).
# Production (Vercel): Supabase transaction pooler (port 6543).
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# Optional: also verify the database server's certificate (CA from the Supabase dashboard).
# DJANGO_DB_SSLMODE=verify-full
# DJANGO_DB_SSLROOTCERT=/path/to/supabase-ca.crt

# Production HSTS. Short by default because browsers remember it; raise once the domain is final.
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_HSTS_PRELOAD=False

# E-mail (password reset + address verification). The features switch on when EMAIL_HOST is set.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Kararsızım <noreply@example.com>
# Local development: print the mails to the console instead of sending them.
# DJANGO_EMAIL_ENABLED=True

# Address shown on the privacy page for personal-data requests (optional).
# DJANGO_CONTACT_EMAIL=

# Rate limiting is on by default (DJANGO_THROTTLE=False turns it off, e.g. for load tests).
# On Vercel the client IP is read from X-Forwarded-For automatically; override only if needed.
# DJANGO_CLIENT_IP_HEADER=HTTP_X_FORWARDED_FOR
